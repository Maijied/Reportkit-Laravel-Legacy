{
    "name": "reportkit/laravel-legacy",
    "description": "Laravel 4.1\u20135.4 adapter for ReportKit (provider, Blade CAS pack, reportkit:make).",
    "type": "library",
    "license": "LicenseRef-Lorapok-NCL-1.0",
    "homepage": "https://github.com/Maijied/Reportkit-Core/tree/main/reportkit-laravel-legacy",
    "support": {
        "issues": "https://github.com/Maijied/Reportkit-Core/issues",
        "source": "https://github.com/Maijied/Reportkit-Core/tree/main/reportkit-laravel-legacy"
    },
    "keywords": [
        "laravel",
        "reportkit",
        "laravel4",
        "laravel5"
    ],
    "authors": [
        {
            "name": "Mohammad Maizied Hasan Majumder",
            "email": "mdshuvo40@gmail.com",
            "homepage": "https://github.com/Maijied",
            "role": "Founder & Principal Engineer"
        }
    ],
    "require": {
        "php": ">=5.6.0",
        "reportkit/core": "^0.1@beta || ^0.1 || 0.1.* || dev-main"
    },
    "autoload": {
        "psr-4": {
            "ReportKit\\Laravel\\Legacy\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "reportkit": {
            "adapter": "laravel-legacy",
            "laravel": {
                "min": "4.1",
                "max": "5.4",
                "display": "4.1 → 5.4"
            },
            "docs": {
                "install": "https://reportkit.lorapok.tech/docs/0.1/adapters/laravel-legacy"
            },
            "install": {
                "composer_require": [
                    "reportkit/core",
                    "reportkit/laravel-legacy"
                ],
                "provider": "ReportKit\\Laravel\\Legacy\\ReportKitServiceProvider",
                "facade_alias": "ReportKit",
                "facade_class": "ReportKit\\Laravel\\Legacy\\Facades\\ReportKit",
                "definitions_path": "app/Reports/",
                "needs_classmap_dump": true,
                "classmap_note": "L4.1",
                "scaffold_example": "php artisan reportkit:make Demo --route=admin/demo-report --preset=hybrid --layout=layouts.master",
                "scaffold_bus_note": "(bus host: --layout=public.admin_master)"
            }
        }
    }
}
