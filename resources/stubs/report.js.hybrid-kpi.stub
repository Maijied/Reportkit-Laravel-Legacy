(function (window) {
    'use strict';
    if (!window.ReportKit || !window.jQuery) {
        return;
    }
    var $ = window.jQuery;
    var cfg = window.ReportKitPageConfig || {};
    var route = cfg.route || '/{{route}}';

    ReportKit.fonts.ensure();
    ReportKit.log.renderPanel('.rk-activity-log');

    function filterParams() {
        var params = {};
        $('#search-pan').serializeArray().forEach(function (item) {
            if (item.name && item.value !== '') { params[item.name] = item.value; }
        });
        return params;
    }

    function refreshKpi(rows) {
        rows = rows || ReportKit.store.rows();
        var total = 0;
        rows.forEach(function (row) {
            total += Number(row && row.amount != null ? row.amount : 0) || 0;
        });
        ReportKit.ui.renderKpiRow('.rk-kpi-row', [
            { key: 'row_count', label: 'Rows', value: rows.length },
            { key: 'total_amount', label: 'Total', value: total.toFixed(2) }
        ]);
    }

    ReportKit.ui.setActionsEnabled('#rkActionBar', false);

    $('#rkPrepareBtn').on('click', function () {
        ReportKit.prepare.run({
            weeksUrl: cfg.weeksUrl || (route + '/weeks'),
            dataUrl: cfg.dataUrl || (route + '/rows'),
            params: filterParams(),
            onComplete: function (rows) {
                refreshKpi(rows);
                ReportKit.ui.setActionsEnabled('#rkActionBar', true);
            },
            onError: function (msg) {
                ReportKit.ui.toast(msg || 'Prepare failed', 'warn');
            }
        });
    });
}(window));
