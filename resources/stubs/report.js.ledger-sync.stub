(function (window) {
    'use strict';
    if (!window.ReportKit || !window.jQuery) {
        return;
    }
    var $ = window.jQuery;
    var slug = '{{slug}}';
    var route = '/{{route}}';

    ReportKit.fonts.ensure();
    ReportKit.syncLoader.bindForm('#search-pan');

    function filterParams() {
        var params = {};
        $('#search-pan').serializeArray().forEach(function (item) {
            params[item.name] = item.value;
        });
        return params;
    }

    function ledgerColumns() {
        return [
            { data: 'transaction_date', title: 'Date' },
            { data: 'transaction_type', title: 'Type', render: ReportKit.table.renderTxnPill('transaction_type') },
            { data: 'pnr', title: 'PNR' },
            { data: 'credit_amount', title: 'Credit', className: 'rk-money' },
            { data: 'debit_amount', title: 'Debit', className: 'rk-money' },
            { data: 'balance', title: 'Balance', className: 'rk-money' }
        ];
    }

    if ($.fn.dataTable) {
        ReportKit.table.mount('#' + slug + 'Table', {
            serverSide: true,
            deferLoading: 0,
            ajax: {
                url: route + '/data',
                data: function (d) {
                    $.extend(d, filterParams());
                },
                dataSrc: function (json) {
                    if (json && json.summary) {
                        ReportKit.table._applyBrowseSummary(json.summary, { kpiSelector: '.rk-kpi-row' });
                        ReportKit.ui.setActionsEnabled('#rkActionBar', true);
                    }
                    return (json && json.data) ? json.data : [];
                }
            },
            columns: ledgerColumns(),
            loaderSelector: '#rkTableLoader'
        });
    }

    $('#rkCsvBtn').on('click', function () {
        window.location = route + '/export?format=csv&' + $.param(filterParams());
    });
}(window));
